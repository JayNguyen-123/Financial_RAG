# Copy to .env for local development. Never commit the real .env.
ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

OPENAI_API_KEY=sk-proj-...
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=financial-scans

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_INGEST_SCOPE=rag:ingest
JWT_ADMIN_SCOPE=rag:admin

# Multi-tenancy: tokens must carry a tenant_id claim (set false for single-tenant)
REQUIRE_TENANT=true
TENANT_CLAIM=tenant_id
GROUPS_CLAIM=groups

# Storage: local | s3   (s3 works with AWS, GCS interop, MinIO: see docker-compose --profile s3)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=

# Narrative text: tesseract | vision | none
TEXT_EXTRACTION=tesseract

# Quotas (per user)
QUERY_RATE_PER_MINUTE=30
INGEST_RATE_PER_HOUR=60
DAILY_TOKEN_BUDGET=2000000

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=financial-multimodal-rag
